# =============================================================================
# hosted-web template — environment variables (COMMITTED, placeholders only)
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# The app builds and runs with EVERY value below unset — nothing here is read
# at import/build time, only lazily inside request handlers (see lib/env.ts).
# =============================================================================

# --- Database (Neon Postgres) ------------------------------------------------
# Connection string for the app database. Absent = no DB-backed features.
DATABASE_URL="postgres://user:password@host/dbname"

# --- Auth (Clerk) ------------------------------------------------------------
# Publishable key is browser-safe (NEXT_PUBLIC_). Secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"

# --- Billing (Stripe) --------------------------------------------------------
# Secret key for API calls; webhook secret verifies inbound webhook signatures.
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# --- AI (per-app, bring-your-own-key) ----------------------------------------
# The AI module is OPT-IN. It stays dormant unless AI_ENABLED is truthy AND a
# key is present. With AI_ENABLED unset, ANTHROPIC_API_KEY is never read.
AI_ENABLED="0"
ANTHROPIC_API_KEY="sk-ant-your-api-key"
