# =============================================================================
# apps/connect (the hub) — environment (COMMITTED, placeholders only)
# =============================================================================
# Copy to .env.local and fill in. NEVER commit .env.local. The app builds and
# boots with every value below unset (lib/env.ts reads lazily, per request).
# The hub NEVER gets a service-role key: privileged work runs in the Edge
# Functions under platform/supabase/functions.
# =============================================================================

PORT="3102"
HOSTNAME="127.0.0.1"

# The PLATFORM Supabase project. Browser-safe; RLS scopes every read.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# Optional. Unset = "Request connection" logs the payload and shows a mailto
# link instead of sending. Never a build or test failure.
RESEND_API_KEY=""

# The `handle` field in shopify.app.toml (W6a managed-pricing follow-up), so
# the /finish route can build https://admin.shopify.com/store/{shop}/charges/{handle}/pricing_plans
# for a Shopify-initiated install with no active subscription, and the hub page
# can build its reopen / install links (all absent when unset). Confirm the
# value against the Partner dashboard before setting it for real — the toml's
# `handle` only takes effect after a deployed app version.
SHOPIFY_APP_HANDLE=""

# Optional, all three or none. The Partner API check that lets a store reinstall
# inside a billing period it already paid for (Shopify's plan page offers nothing
# to approve until the period ends). Any unset = that reinstall lands on the plan
# page. TOKEN is a secret: Partner dashboard > Settings > Partner API clients,
# "Manage apps" permission only. ORG_ID is the Partner organization id (the
# number in the Partner dashboard URL); APP_GID is gid://shopify/App/<app id>.
SHOPIFY_PARTNER_API_TOKEN=""
SHOPIFY_PARTNER_ORG_ID=""
SHOPIFY_APP_GID=""

# Optional. Unset = the shop/redact webhook falls back to today's operator email
# (docs/architecture/retention-30d-shop-redact.md). Set to the deployed
# shopify-shop-redact Edge Function URL to queue automated deletion instead.
# The app/uninstalled webhook forwards to the same function and has no fallback:
# while this is unset it answers 503 and Shopify keeps retrying.
SHOP_REDACT_FUNCTION_URL=""
