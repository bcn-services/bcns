# apps/hq — environment variable NAMES only (copy to .env.local; never commit it).
# Read lazily by lib/env.ts; the app builds and runs with all of them unset.
# NEVER set SUPABASE_SERVICE_ROLE_KEY here: scripts/check-env.ts fails the build.

# HQ Supabase project (not the platform project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, read by later items
HQ_LATE_STAGES=
PLATFORM_OPS_URL=
STRIPE_KEY=
MERCURY_KEY=

# Numbers + Ops (item 6). All optional; the page shows "unavailable" for whatever is unset.
# PLATFORM_OPS_URL shape: postgresql://hq_ops_ro:<password>@<host>:5432/postgres?sslmode=require
#   (read-only role, metadata views in schema ops; Nate sets the password by hand)
# STRIPE_KEY: restricted READ-ONLY key. MERCURY_KEY: read-only API token (Transactions API is free).
# MERCURY_INVOICING=1 turns on the invoice list; Mercury's Invoicing API needs a PAID Mercury plan.
MERCURY_INVOICING=
INSTINCT_URL=
SENTRY_URL=
