{
  "extends": "@bcn-services/config/tsconfig/base.json",
  "compilerOptions": {
    // Plain Node ESM, not a bundler: the MCP SDK ships subpath exports
    // ("@modelcontextprotocol/sdk/server/index.js") that only resolve under NodeNext.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src"]
}
