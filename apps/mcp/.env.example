# apps/mcp — copy to /srv/mcp/env on the droplet. Anon key only; this process never holds a
# credential stronger than the caller's own Bearer token.
PORT=3103
HOSTNAME=127.0.0.1
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<the project anon key>
# Requests per minute per caller token. Optional; defaults to 60.
MCP_RATE_LIMIT_PER_MIN=60
