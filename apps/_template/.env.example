# =============================================================================
# apps/_template — environment variables (COMMITTED, placeholders only)
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# The app builds and runs with EVERY value below unset — nothing here is read
# at import/build time, only lazily inside request handlers (see lib/env.ts).
#
# Shared-platform mode only: there is no per-client Supabase project. Every
# stamped app reads the ONE platform project via @bcn-services/data-client.
# =============================================================================

# --- Supabase (the platform project — same URL/anon key for every app) -------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# --- Tenant pin ---------------------------------------------------------------
# This client's client_id. packages/tenant's middleware rejects a signed-in
# session whose membership.clientId doesn't match (R39: a client app reads
# only its own rows). Set by scripts/new-app.sh / onboarding, not by hand.
EXPECTED_CLIENT_ID=""

# --- Health / smoke user -------------------------------------------------------
# /api/health signs in with this client's smoke user (printed once by the
# platform's `onboard`; re-set after `rotate-smoke`).
HEALTH_EMAIL=""
HEALTH_PASSWORD=""
# `pnpm agent` signs in as this client's per-client agent user (email
# agent+<slug>@bcn-services.com, minted once by `add-member --agent`).
AGENT_EMAIL=""
AGENT_PASSWORD=""

# --- AI (per-app, bring-your-own-key) ----------------------------------------
# The AI module is OPT-IN. It stays dormant unless AI_ENABLED is truthy AND a
# key is present. With AI_ENABLED unset, ANTHROPIC_API_KEY is never read.
AI_ENABLED="0"
ANTHROPIC_API_KEY="sk-ant-your-api-key"
