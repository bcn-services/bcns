# Worker / scripts (never commit real values; .env.local is gitignored)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BCNS_ALERT_EMAIL=
EGRESS_ALLOWANCE_BYTES=268435456000
RUN_BUDGET_MS=240000
RENORMALIZE_BUDGET_MS=120000
CLAIM_LIMIT=24
TASK_COUNT=1
# QuickBooks (worker, opt-in; only read while pulling a QuickBooks source). ENV is sandbox|production, no default.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
