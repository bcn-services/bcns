# Worker / scripts (never commit real values; .env.local is gitignored)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BCNS_ALERT_EMAIL=
EGRESS_ALLOWANCE_BYTES=268435456000
RUN_BUDGET_MS=240000
RENORMALIZE_BUDGET_MS=120000
CLAIM_LIMIT=24
TASK_COUNT=1
# QuickBooks (worker, opt-in; only read while pulling a QuickBooks source). ENV is sandbox|production, no default.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
# Google Meet/Drive (worker, opt-in; the bcns-owned OAuth client). Only read when refreshing a Google token for a row that carries no
# attributes.oauth_client_secret of its own; the secret is sent only with a row whose client id equals GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta (worker, opt-in; same app as the hub). Only read when re-exchanging a Meta token inside its 14-day refresh window.
META_CLIENT_ID=
META_CLIENT_SECRET=
