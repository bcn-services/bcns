{
  "name": "bcns-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "tick": "tsx worker/src/index.ts",
    "contract:update": "tsx test/contract-update.ts",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --lang typescript --schema api --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres > packages/data-client/src/database.types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@supabase/supabase-js": "^2.58.0",
    "p-limit": "^6.2.0",
    "pg": "^8.16.3",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "jose": "^6.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
